@startuml
start
:(1) Người dùng truy cập trang "Quên mật khẩu";
:(2) Nhập email đăng ký;
:(3) Nhấn nút "Gửi yêu cầu đặt lại mật khẩu";
:(4) Kiểm tra hợp lệ email đầu vào;
if (5) Email hợp lệ? then (Có)
  :(6) Kiểm tra tài khoản có tồn tại và không bị xóa;
  if (7) Tài khoản hợp lệ? then (Có)
    :(8) Tạo token đặt lại mật khẩu;
    :(9) Gửi email đặt lại mật khẩu cho người dùng;
    :(10) Hiển thị thông báo "Vui lòng kiểm tra email để đặt lại mật khẩu";
    stop
  else (Không)
    :(11) Hiển thị lỗi "Tài khoản không tồn tại hoặc đã bị xóa";
    stop
  endif
else (Không)
  :(12) Hiển thị lỗi nhập liệu;
  stop
endif

:(13) Người dùng nhấn vào liên kết đặt lại mật khẩu trong email;
:(14) Hệ thống nhận token đặt lại mật khẩu;
:(15) Kiểm tra token có tồn tại và hợp lệ không;
if (16) Token hợp lệ? then (Có)
  :(17) Nhập mật khẩu mới;
  :(18) Kiểm tra hợp lệ mật khẩu mới;
  if (19) Mật khẩu hợp lệ? then (Có)
    :(20) Cập nhật mật khẩu mới cho tài khoản;
    :(21) Ghi log đặt lại mật khẩu thành công;
    :(22) Hiển thị thông báo "Đặt lại mật khẩu thành công";
    stop
  else (Không)
    :(23) Hiển thị lỗi nhập liệu mật khẩu;
    stop
  endif
else (Không)
  :(24) Hiển thị lỗi "Token không hợp lệ hoặc đã hết hạn";
  stop
endif
@enduml