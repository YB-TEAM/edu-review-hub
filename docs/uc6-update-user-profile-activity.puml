@startuml
start
:(1) Người dùng truy cập trang hồ sơ cá nhân;
:(2) Nhấn nút "Chỉnh sửa hồ sơ";
:(3) Nhập/thay đổi thông tin hồ sơ (tên, ảnh, ngày sinh, trường, chuyên ngành...);
:(4) Nhấn nút "Lưu thay đổi";
:(5) Kiểm tra hợp lệ thông tin đầu vào;
if (6) Thông tin hợp lệ? then (Có)
  :(7) Cập nhật thông tin hồ sơ trong hệ thống;
  :(8) Ghi log chỉnh sửa hồ sơ;
  :(9) Hiển thị thông báo cập nhật thành công;
  stop
else (Không)
  :(10) Hiển thị lỗi nhập liệu;
  stop
endif
@enduml